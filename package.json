    "enrich:skku-grad:dblp": "tsx scripts/enrich-skku-dblp.ts",
    "validate:sogang-grad": "tsx scripts/validate-sogang-grad.ts",
    "validate:skku-grad": "tsx scripts/validate-skku-grad.ts",
    "validate:uos-grad": "tsx scripts/validate-uos-grad.ts",
    "upsert:uos-grad": "tsx scripts/upsert-uos-grad.ts",
    "validate:khu-grad": "tsx scripts/validate-khu-grad.ts",
    "audit:khu-grad": "tsx scripts/audit-khu-grad.ts",
    "upsert:khu-grad": "tsx scripts/upsert-khu-grad.ts",
    "validate:cau-grad": "tsx scripts/validate-cau-grad.ts",
    "validate:hufs-grad": "tsx scripts/validate-hufs-grad.ts",
