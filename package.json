    "report:hanyang-overall": "tsx scripts/report-hanyang-overall.ts",
    "report:seed-html": "tsx scripts/write-seed-html-report.ts",
    "record:crawler-fix": "tsx scripts/record-crawler-fix.ts",
    "reset:hanyang-supabase": "tsx scripts/reset-hanyang-supabase.ts",
    "repair:sogang-cs": "tsx scripts/repair-sogang-cs-lab-links.ts",
    "repair:sogang-campus-labs": "tsx scripts/repair-sogang-campus-labs.ts",
    "repair:sogang-member-counts": "tsx scripts/repair-sogang-member-counts.ts",
    "repair:skku-grad": "tsx scripts/repair-skku-grad.ts",
    "resolve:skku-grad-lab-urls": "tsx scripts/resolve-skku-grad-lab-urls.ts",
