{
  "name": "kr-labs",
  "version": "0.1.0",
  "private": true,
  "description": "KR_Labs crawling pipeline MVP for Korean university labs.",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @kr-labs/web dev",
    "typecheck": "pnpm -r typecheck",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/db/src/database.types.ts",
    "seed:universities": "tsx scripts/seed-universities.ts",
    "crawl:school": "tsx scripts/crawl-school.ts",
    "crawl:dry-run": "tsx scripts/dry-run-crawl.ts",
    "discover:kaist-grad": "tsx scripts/discover-kaist-grad.ts",
    "discover:skku-grad": "tsx scripts/discover-skku-grad.ts",
    "discover:sogang-grad": "tsx scripts/discover-sogang-grad.ts",
    "discover:uos-grad": "tsx scripts/discover-uos-grad.ts",
    "discover:khu-grad": "tsx scripts/discover-khu-grad.ts",
    "discover:cau-grad": "tsx scripts/discover-cau-grad.ts",
    "discover:hufs-grad": "tsx scripts/discover-hufs-grad.ts",
    "discover:hanyang-grad": "tsx scripts/discover-hanyang-grad.ts",
    "discover:seed": "tsx scripts/discover-seed.ts",
    "report:hanyang-department-labs": "tsx scripts/report-hanyang-department-labs.ts",
